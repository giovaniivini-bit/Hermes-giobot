custom_providers:
  - name: groq
    base_url: "https://api.groq.com/openai/v1"
    key_env: GROQ_API_KEY
    model:
      default: "llama-3.3-70b-versatile"

provider: custom:groq
model:
  default: "llama-3.3-70b-versatile"
  context_length: 65536
  ollama_num_ctx: 65536

fallback_model:
  provider: ollama
  model: llama3.1
  base_url: "http://ollama:11434/v1"
  context_length: 65536
  ollama_num_ctx: 65536

